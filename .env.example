# Benzo configuration. Copy it with `cp .env.example .env` (.env is gitignored) and load it with
# `set -a; . ./.env; set +a` from the repo root. Every value here is public; keys are generated locally under
# $BNZ_STATE_DIR and never go in this file.

# --- Zcash testnet ---

# Network passed to every tool.
BNZ_NETWORK=test

# lightwalletd endpoint (host:port, gRPC over TLS): wallet sync, transaction fetch, broadcast.
BNZ_LWD_URL=testnet.zec.rocks:443

# A second, independently implemented endpoint (Zaino), used to cross-check heights and transactions.
BNZ_LWD_URL_ALT=zaino.testnet.unsafe.zec.rocks:443

# --- drand quicknet (public protocol constants; the sealer pins them) ---

# Relays used to fetch round R, comma-separated.
BNZ_DRAND_URLS=https://api.drand.sh,https://api2.drand.sh,https://api3.drand.sh,https://drand.cloudflare.com

# Chain hash, BLS public key (hex), genesis (Unix seconds) and period (seconds).
# The first round at or after time T is R = 1 + ceil((T - genesis) / period).
BNZ_DRAND_CHAIN_HASH=52db9ba70e0cc0f6eaf7803dd07447a1f5477735fd3f661792ba94600c84e971
BNZ_DRAND_PUBLIC_KEY=83cf0f2896adee7eb8b5f01fcad3912212c437e0073e911fb90022d3e760183c8c4b450b6a0a6c3ac6a5776a2d1064510d1fec758c921cc22b0e17e63aaf4bcb5ed66304de9cf809bd274ca73bab4af5a6e9c76a4bc09e76eae8991ef5ece45a
BNZ_DRAND_GENESIS=1692803367
BNZ_DRAND_PERIOD=3

# --- Auctions ---

# Default fixed deposit per bid, in zatoshis.
BNZ_COLLATERAL_ZATS=500000

# --- Local state ---

# Gitignored directory, resolved from the repo root. It holds built binaries, wallets, FROST configs and key packages,
# the local TLS CA and logs. Never commit or print its key material.
BNZ_STATE_DIR=./.benzo

# Local frostd relay for DKG and signing sessions.
BNZ_FROSTD_ADDR=localhost:2744

# --- Cross-chain payouts (public endpoints and the deployed testnet escrows) ---
# Deployer keys live only under $BNZ_STATE_DIR/evm/deployer.key and $BNZ_STATE_DIR/solana/deployer.json.
BNZ_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BNZ_SOLANA_DEVNET_RPC=https://api.devnet.solana.com
BNZ_XCHAIN_EVM_ESCROW=0x1dc207D5B04C8CFB043d4420054a2219a544dD85
BNZ_XCHAIN_SOL_PROGRAM=2h6tgr5Ay1WE3u6kmPZnKh9EyTu7dkgWFkkrjCA5QyPu
