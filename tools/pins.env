# Every pinned tool. tools/bootstrap.sh builds them into $BNZ_STATE_DIR/bin. Changing a pin needs a Ruling
# (except the trap-1 devtool fallbacks the phase doc pre-authorizes; record those under Deviations in STATUS).

# zcash-devtool (pczt 0.9.3). Trap-1 fallbacks: f00def6aac4b (pczt 0.8.0-rc.1), then fabd984c1e38 (pczt 0.7.0).
DEVTOOL_GIT=https://github.com/zcash/zcash-devtool
DEVTOOL_REV=5a26ee854e634a4e88d1d79dab13f8fbb1eac6b8

# frost-tools: frostd, frost-client, zcash-sign (pczt 0.8.0-rc.1; orchard patched to conradoplg 42015f1).
FROST_TOOLS_GIT=https://github.com/ZcashFoundation/frost-tools
FROST_TOOLS_REV=06c0dbdbb1bac9b99cd255e74ba2f387c295e660

# Go tools.
TLE_PKG=github.com/drand/tlock/cmd/tle
TLE_TAG=v1.2.0
GRPCURL_PKG=github.com/fullstorydev/grpcurl/cmd/grpcurl
GRPCURL_TAG=v1.9.3

# lightwalletd protos for grpcurl, fetched at this commit (not the walletrpc/ symlinks) and checked by SHA-256.
LWD_PROTO_REV=d16d48124e9ad4157ebc2324b5090c6ba201470c
LWD_PROTO_URL=https://raw.githubusercontent.com/zcash/lightwalletd/$LWD_PROTO_REV/lightwallet-protocol/walletrpc
LWD_PROTO_SHA256_SERVICE=6fbfa974081fb02366a3118a25764af289bdbb86688978f5ff2bae661dfa346a
LWD_PROTO_SHA256_COMPACT_FORMATS=d8d0c8aaa5ceec7d5dcc188ef25b04011df2ec0254901620fce982fc13aeb32d

# npm packages are pinned exactly in package.json and package-lock.json: tlock-js, @playwright/test, esbuild.
