---
import Shell from "../../components/page/Shell.astro";
import { auctions } from "../../lib/server";
import { glyphFor, marketOf } from "../../lib/glyphs";
import { MODE_NAME, thousands, utc } from "../../lib/api";
const list = await auctions();
const now = Date.now() / 1000;
const groups = [
  { word: "Running now", rows: list.filter((a) => a.live || (!["SETTLED", "CANCELLED"].includes(a.state) && now - a.updated < 6 * 3600)) },
  { word: "Settled", rows: list.filter((a) => a.state === "SETTLED") },
  { word: "Cancelled and refunded in full", rows: list.filter((a) => a.state === "CANCELLED") },
  { word: "Stopped mid-way in test runs", rows: list.filter((a) => !["SETTLED", "CANCELLED"].includes(a.state) && !a.live && now - a.updated >= 6 * 3600) },
].filter((g) => g.rows.length);
---
<Shell title="Every lot – Benzo" description="Every auction Benzo ran on Zcash testnet, with its state and result.">
  <article class="card-in mx-auto w-full max-w-[720px] bg-surface text-ink" style="clip-path: polygon(44px 0, 100% 0, 100% 100%, 0 100%, 0 44px)">
    <div class="h-11"></div>
    <h1 class="rise rise-1 px-6 pt-3 font-sans text-[clamp(1.75rem,1.2rem+2vw,2.5rem)]" data-all={`${list.length} rounds on Zcash testnet`}>{list.length} rounds on Zcash testnet</h1>
    <div class="px-6 pb-8 pt-2">
      {groups.map((g) => (
        <section class="rise rise-3 mt-8" aria-label={g.word} data-group>
          <h2 class="font-sans text-[15px] tracking-tight text-muted">{g.word} <span class="tabular">({g.rows.length})</span></h2>
          <ul class="mt-2">
            {g.rows.map((a) => (
              <li data-market={marketOf(a.mode)}>
                <a href={`/auction/?id=${a.id}`} class="group flex min-h-[44px] items-center gap-3 font-sans md:min-h-[38px]" data-testid="lot-row">
                  <img src={`/doodles/${glyphFor(a.mode, a.id)}.svg`} alt="" class="size-6 flex-none bg-leaf-deep p-1" />
                  <span class="min-w-0 truncate text-[15px] text-ink group-hover:text-moss">{a.lot ?? MODE_NAME[a.mode]}</span>
                  <span class="hidden shrink-0 text-[13px] text-muted sm:inline">{MODE_NAME[a.mode]}</span>
                  <span class="ml-auto shrink-0 text-[13px] text-muted tabular">{a.state === "SETTLED" && a.clearing_price_zats && a.clearing_price_zats !== "0" ? `cleared ${thousands(a.clearing_price_zats)} zats` : a.state === "SETTLED" ? `settled ${utc(a.updated)}` : utc(a.updated)}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </article>
  <script>
    // ?market=<mode> (a market's "All rounds"): only that market's rounds.
    import { MODE_NAME } from "../../lib/api";
    const m = new URLSearchParams(location.search).get("market");
    if (m && MODE_NAME[m]) {
      let n = 0;
      for (const li of document.querySelectorAll<HTMLElement>("li[data-market]")) { const on = li.dataset.market === m; li.hidden = !on; n += Number(on); }
      for (const g of document.querySelectorAll<HTMLElement>("section[data-group]")) {
        const shown = g.querySelectorAll("li[data-market]:not([hidden])").length;
        g.hidden = shown === 0;
        const c = g.querySelector(".tabular"); if (c) c.textContent = `(${shown})`;
      }
      document.querySelector("h1")!.textContent = `${n} ${MODE_NAME[m].toLowerCase()} rounds`;
    }
  </script>
</Shell>
