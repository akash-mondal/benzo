---
// All rounds. The list ships as built, then keeps itself current (see RoundsView). ?market=<mode> arrives from a
// market's "All rounds".
import Shell from "../../components/page/Shell.astro";
import RoundsView from "../../components/views/RoundsView";
import { auctions } from "../../lib/server";
const list = await auctions();
---
<Shell title="Rounds – Benzo" description="Every round run through Benzo on Zcash testnet, and how each one ended." full fit>
  <RoundsView client:load initial={list} />
</Shell>
