---
import Base from "../layouts/Base.astro";
import Sky from "../components/universe/Sky";
import { auctions } from "../lib/server";
const list = await auctions();
---
<Base>
  <div class="relative h-dvh w-full overflow-hidden bg-ground">
    <h1 class="sr-only">Benzo · markets on Zcash testnet</h1>
    <Sky client:only="react" initial={list} />
  </div>
  <noscript><p style="padding:2rem;color:#ddd6c6">The sky needs script; <a href="/lots/">every lot</a> is plain HTML.</p></noscript>
</Base>
