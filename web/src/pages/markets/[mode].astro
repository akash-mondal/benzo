---
// One market's own sky: every round of that market, plus doors home and to the other five.
import Base from "../../layouts/Base.astro";
import Sky from "../../components/universe/Sky";
import { auctions } from "../../lib/server";
import { MODE_NAME } from "../../lib/api";
import { MARKETS, marketOf, type Market } from "../../lib/glyphs";
export function getStaticPaths() { return MARKETS.map((mode) => ({ params: { mode } })); }
const market = Astro.params.mode as Market;
const list = await auctions();
const n = list.filter((a) => marketOf(a.mode) === market).length;
const name = MODE_NAME[market];
---
<Base title={`${name} – Benzo`} description={`${name} rounds run through Benzo on Zcash testnet: sealed until a public drand round, settled by 2-of-3 FROST, checkable offline.`}>
  <div class="relative h-dvh w-full overflow-hidden bg-ground">
    <h1 class="sr-only">{name}: {n} rounds on Zcash testnet</h1>
    <Sky client:only="react" initial={list} market={market} />
  </div>
  <noscript><p style="padding:2rem;color:#ddd6c6">The sky needs script; <a href="/lots/">every lot</a> is plain HTML.</p></noscript>
</Base>
