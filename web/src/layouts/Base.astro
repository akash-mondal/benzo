---
import "../styles/global.css";
const { title = "Benzo – sealed-bid markets on Zcash", description = "Sealed-bid auctions, buybacks, RFQs, OTC and launches on Zcash testnet. Bids stay sealed until a public drand round; settlement is 2-of-3 FROST; every result verifies offline." } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/doodles/sealed-envelope.svg?v=2" type="image/svg+xml" />
  </head>
  <body class="min-h-dvh text-sand">
    <slot />
  </body>
</html>
