---
// Every screen after the landing: a slim top bar (Back, the mark, the places, one action), then the page's column. On a
// phone the places fold into a Menu; the mark stays. The "Start a round" action steps aside on pages that are already a
// task of their own (starting a round, bidding).
import Base from "../../layouts/Base.astro";
import Back from "./Back.astro";
const { title, description, back = "/", cta = true, full = false, fit = false } = Astro.props;
// fit: the page is built to be one window on a laptop (its panels scroll inside); other pages scroll as usual.
// full: the page uses the whole width (the round terminal), like an exchange's trade screen.
const frame = full ? "max-w-none px-3 sm:px-4" : "max-w-[1120px] px-5 sm:px-8";
const path = Astro.url.pathname;
const links = [{ href: "/lots/", label: "Rounds" }, { href: "/mine/", label: "My activity" }, { href: "/verify/", label: "Verify" }];
---
<Base title={title} description={description}>
  <div class="app min-h-dvh">
    <header class="app-header sticky top-0 z-30 border-b border-app-line bg-[#141a10b3] backdrop-blur-xl">
      <div class:list={["mx-auto flex h-14 items-center justify-between gap-3", frame]}>
        <div class="flex min-w-0 items-center gap-3 sm:gap-5">
          <Back href={back} tone="app" />
          <a href="/" class="chrome serif-figure pr-1 text-[26px] leading-none" aria-label="Benzo, all markets">Benzo</a>
          <span class="hidden rounded-full px-2 py-0.5 text-[12px] text-app-faint ring-1 ring-app-line md:inline">Testnet</span>
        </div>
        <nav aria-label="Pages" class="flex items-center gap-1 text-[14px]">
          {links.map((l) => <a href={l.href} aria-current={path.startsWith(l.href) ? "page" : undefined} class:list={["hidden rounded-full px-3 py-1.5 transition-colors hover:text-app-text md:inline", path.startsWith(l.href) ? "bg-[#ddd6c614] text-app-text ring-1 ring-app-line" : "text-app-muted"]}>{l.label}</a>)}
          {cta && <a href="/start/" class="ml-2 hidden h-9 items-center rounded-full bg-sand px-4 text-[14px] font-semibold text-ink transition-transform hover:bg-[#ebe5d6] active:scale-[0.98] md:inline-flex">Start a round</a>}
          <details class="relative md:hidden" data-menu>
            <summary class="flex h-10 cursor-pointer list-none items-center gap-2 rounded-full bg-[#ddd6c60d] px-4 text-[14px] text-app-text ring-1 ring-app-line [&::-webkit-details-marker]:hidden" data-testid="menu">Menu</summary>
            <div class="absolute right-0 top-12 z-40 w-56 overflow-hidden rounded-2xl bg-[#1b2216f0] py-1 shadow-[0_12px_40px_rgba(0,0,0,0.5)] ring-1 ring-app-line backdrop-blur-xl">
              {[{ href: "/", label: "Markets" }, ...links, { href: "/start/", label: "Start a round" }].map((l) => <a href={l.href} aria-current={l.href !== "/" && path.startsWith(l.href) ? "page" : undefined} class="flex h-11 items-center px-4 text-[15px] text-app-text hover:bg-app-2 aria-[current=page]:text-gold">{l.label}</a>)}
            </div>
          </details>
        </nav>
      </div>
    </header>
    <!-- One container for every screen, the header's: every left edge on the page lines up. On a big enough screen the
         page is exactly one window (fit): the view inside fills it and nothing scrolls. -->
    <main class:list={["mx-auto", fit && "fit:flex fit:h-[calc(100dvh-3.5rem-1px)] fit:flex-col fit:overflow-hidden", frame, full ? "pb-6 pt-3 fit:pb-1 fit:pt-2" : fit ? "pb-24 pt-8 sm:pt-12 fit:pb-6 fit:pt-7" : "pb-24 pt-8 sm:pt-12"]}><slot /></main>
  </div>
</Base>
<script>
  // The phone menu closes on outside tap and on Escape (Escape closes the topmost layer and nothing else).
  const m = document.querySelector<HTMLDetailsElement>("details[data-menu]");
  document.addEventListener("click", (e) => { if (m?.open && !m.contains(e.target as Node)) m.open = false; });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && m?.open) { m.open = false; m.querySelector("summary")?.focus(); } });
</script>
