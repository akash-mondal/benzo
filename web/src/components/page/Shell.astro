---
// Every screen after the landing: a slim top bar (Back, the mark, the places, one action), then the page's column.
import Base from "../../layouts/Base.astro";
import Back from "./Back.astro";
const { title, description, back = "/", wide = false } = Astro.props;
const path = Astro.url.pathname;
const links = [{ href: "/lots/", label: "Every lot" }, { href: "/mine/", label: "Mine" }, { href: "/verify/", label: "Verify" }];
---
<Base title={title} description={description}>
  <div class="app min-h-dvh">
    <header class="sticky top-0 z-30 border-b border-app-line bg-app">
      <div class="mx-auto flex h-14 max-w-[1120px] items-center justify-between gap-4 px-5 sm:px-8">
        <div class="flex min-w-0 items-center gap-3 sm:gap-5">
          <Back href={back} tone="app" />
          <a href="/" class="hidden items-center gap-2 text-[15px] font-semibold tracking-tight text-app-text sm:flex"><img src="/doodles/sealed-envelope.svg?v=2" alt="" class="size-5" />Benzo</a>
        </div>
        <nav aria-label="Pages" class="flex items-center gap-1 text-[14px]">
          {links.map((l) => <a href={l.href} class:list={["hidden rounded-full px-3 py-1.5 transition-colors hover:text-app-text sm:inline", path.startsWith(l.href) ? "text-app-text" : "text-app-muted"]}>{l.label}</a>)}
          <a href="/mine/" class="rounded-full px-3 py-1.5 text-app-muted hover:text-app-text sm:hidden">Mine</a>
          <a href="/start/" class="ml-2 inline-flex h-9 items-center rounded-full bg-white px-4 text-[14px] font-semibold text-black transition-transform hover:bg-[#e6e6e6] active:scale-[0.98]">Start a round</a>
        </nav>
      </div>
    </header>
    <!-- One container for every screen, the header's: every left edge on the page lines up. -->
    <main class="mx-auto max-w-[1120px] px-5 pb-24 pt-8 sm:px-8 sm:pt-12"><slot /></main>
  </div>
</Base>
