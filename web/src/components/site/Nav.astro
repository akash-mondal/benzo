---
// The plain bar: the mark and name, four pages, nothing else.
const { current = "" } = Astro.props;
const links = [
  { href: "/lots/", label: "Every lot" },
  { href: "/how/", label: "How it works" },
  { href: "/verify/", label: "Verify" },
  { href: "/bid/", label: "Bid live" },
];
---
<header class="wrap relative z-30 flex items-center justify-between pt-7">
  <a href="/" class="flex items-center gap-2.5 font-sans text-[17px] font-bold tracking-tight text-ink" aria-label="Benzo, home">
    <svg viewBox="0 0 32 32" class="size-7 text-moss" aria-hidden="true"><path fill="currentColor" d="M3 7h26v18H3z"/><path d="M4 8l12 9 12-9" fill="none" stroke="#ddd6c6" stroke-width="2.2" stroke-linejoin="round"/><circle cx="16" cy="18.5" r="3.6" fill="#ddd6c6"/></svg>
    Benzo
  </a>
  <nav aria-label="Pages">
    <ul class="flex items-center gap-5 font-sans text-[15px] sm:gap-8">
      {links.map((l) => (
        <li class={l.href === "/bid/" ? "" : "hidden md:block"}>
          <a href={l.href} class:list={["transition-colors hover:text-moss", current === l.href ? "text-moss" : "text-ink"]} aria-current={current === l.href ? "page" : undefined}>{l.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>
