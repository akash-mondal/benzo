--- tmp/r48/pins-check.ts ---
import { copyFileSync, readFileSync, writeFileSync } from "node:fs";
import { execFileSync } from "node:child_process";
import path from "node:path";
import { pinsMismatch } from "../../e2e/lib/pins";
import { STATE } from "../../e2e/lib/env";
const co = path.join(STATE, "src", "frost-tools-06c0dbdbb1bac9b99cd255e74ba2f387c295e660");
const tamper = (label: string, apply: () => void, restore: () => void) => {
  apply(); let r: string | undefined; try { r = pinsMismatch(); } finally { restore(); }
  console.log(`${r ? "REFUSED" : "ACCEPTED (FAIL)"} ${label}: ${r ?? ""}`);
};
const keepFile = (f: string) => { const o = readFileSync(f); return () => writeFileSync(f, o); };
console.log(`real tools: ${pinsMismatch() ?? "OK"}`);
const bin = path.join(STATE, "bin", "zcash-sign"); let rb = keepFile(bin);
tamper("S2 tampered zcash-sign binary", () => writeFileSync(bin, Buffer.concat([readFileSync(bin), Buffer.from("tamper")])), rb);
const src = path.join(co, "zcash-sign", "src", "main.rs"); let rs = keepFile(src);
tamper("S4 edited zcash-sign source", () => writeFileSync(src, readFileSync(src, "utf8") + "\n// tamper\n"), rs);
const prov = path.join(STATE, "nu7-provenance", "zcash-sign.json"); let rp = keepFile(prov);
tamper("S6 record lists no patches", () => { const j = JSON.parse(readFileSync(prov, "utf8")); j.patches = {}; writeFileSync(prov, JSON.stringify(j)); }, rp);
const toml = path.join(co, "Cargo.toml"); let rt = keepFile(toml);
tamper("S7 extra Cargo.toml edit", () => writeFileSync(toml, readFileSync(toml, "utf8") + "\n[profile.release]\noverflow-checks = false\n"), rt);
tamper("S9 skip-worktree hidden source edit", () => { execFileSync("git", ["-C", co, "update-index", "--skip-worktree", "zcash-sign/src/main.rs"]); writeFileSync(src, readFileSync(src, "utf8") + "\n// hidden\n"); },
  () => { rs(); execFileSync("git", ["-C", co, "update-index", "--no-skip-worktree", "zcash-sign/src/main.rs"]); });
console.log(`restored: ${pinsMismatch() ?? "OK"}`);
