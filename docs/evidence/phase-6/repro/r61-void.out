// R61 offline proof (head): the void-bond rules on the shipped code.
import { generateKeyPairSync } from "node:crypto";
import { obligationsModeA } from "../../clear/core";
import { balanceSettlement, bondVoidAt } from "../../clear/features";
import { signApprovalMap, verifyApprovalMap, earliestAgreedBond, earliestAgreedDefaults } from "../../witness";
let all = true; const line = (id: string, ok: boolean, d: string) => { console.log(`${ok ? "PASS" : "FAIL"} ${id} ${d}`); all &&= ok; };
const C = 1_000_000n;
// Two bonded winners (bond = C, price 300000 + balance 200000 owed) and one loser.
const result: any = { conservation: { payout_zats: "600000" }, allocations: [
  { leaf_index: 0, fill: 1, payment_zats: "300000", refund_zats: "900000", balance_due_zats: "200000" },
  { leaf_index: 1, fill: 1, payment_zats: "300000", refund_zats: "900000", balance_due_zats: "200000" },
  { leaf_index: 2, fill: 0, payment_zats: "0", refund_zats: String(C), balance_due_zats: "0" } ] };
const normal = Object.fromEntries(obligationsModeA(result, { defaults: [], balance_refunds: [] }));
const voided = Object.fromEntries(obligationsModeA(result, { defaults: [], balance_refunds: [], bond_void: true }));
line("r61-normal", normal.seller === "600000" && normal["leaf:0"] === "900000", JSON.stringify(normal));
line("r61-void-refunds-all", voided["leaf:0"] === "1000000" && voided["leaf:1"] === "1000000" && voided["leaf:2"] === "1000000" && voided.seller === undefined, JSON.stringify(voided));
let threw = ""; try { obligationsModeA(result, { defaults: [0], bond_void: true }); } catch (e) { threw = (e as Error).message; }
line("r61-void-no-defaults", /void bond has no defaults/.test(threw), threw);
// bondVoidAt: release = genesis + (R-1)*period.
const m: any = { drand: { genesis: 1000, period: 3, R: 11 }, confirmations: 10, deposit_addresses: ["d0", "d1", "d2"],
  bond: { bond_bps: 1000, balance_window_start_height: 100, balance_window_blocks: 40, balance_addresses: ["b0", "b1", "b2"] } };
line("r61-void-at", bondVoidAt(m, 1029) === true && bondVoidAt(m, 1030) === false, "start header 1029 < release 1030 is void; 1030 is not");
const leaves: any = [0, 1, 2].map(i => ({ leaf_index: i, deposit: { address: `d${i}` } }));
const notes: any = [{ txid: "aa", pool: "ironwood", action_index: 0, address: "b0", value_zats: "200000", height: 110 }];
const s0 = balanceSettlement(m, result, leaves, notes, 200), s1 = balanceSettlement(m, result, leaves, notes, 200, true);
line("r61-balance-normal", s0.sources.length === 1 && s0.refunds.length === 0, `sources ${s0.sources.length} refunds ${s0.refunds.length}`);
line("r61-balance-void", s1.sources.length === 0 && s1.refunds.length === 1 && s1.refunds[0].amount_zats === "200000" && s1.refunds[0].leaf_index === 0, JSON.stringify(s1.refunds));
// Maps: the field joins the signed bytes only when true; a tampered flag fails verification.
const keyPair = () => { const k = generateKeyPairSync("ed25519"); return { priv: Buffer.from(k.privateKey.export({ type: "pkcs8", format: "der" })).subarray(16).toString("hex"), pub: Buffer.from(k.publicKey.export({ type: "spki", format: "der" })).subarray(12).toString("hex") }; };
const [ka, kb] = [keyPair(), keyPair()], keys = [ka.pub, kb.pub];
const body: any = { auction_id: "x", batch: 1, txid: "t1", outputs: [], defaults: [], balance_refunds: [] };
const plainA = signApprovalMap(body, ka.priv), voidA = signApprovalMap({ ...body, bond_void: true }, ka.priv), voidB = signApprovalMap({ ...body, bond_void: true }, kb.priv);
line("r61-map-backcompat", verifyApprovalMap(plainA, keys) && !("bond_void" in plainA), "a map without the field verifies and carries no field");
line("r61-map-tamper", verifyApprovalMap(voidA, keys) && !verifyApprovalMap({ ...voidA, bond_void: false } as any, keys) && !verifyApprovalMap({ ...plainA, bond_void: true } as any, keys), "flipping bond_void either way breaks the signature");
const agreed = earliestAgreedBond([voidA, voidB], keys, ["t1"]); let mixed: any = "not computed";
line("r61-agreed-pair", agreed?.bond_void === true && JSON.stringify(agreed?.defaults) === "[]" && earliestAgreedDefaults([voidA, voidB], keys, ["t1"])?.length === 0, JSON.stringify(agreed));
let mixedErr = ""; try { mixed = earliestAgreedBond([plainA, voidB], keys, ["t1"]); } catch (e) { mixedErr = (e as Error).message; }
line("r61-disagree", mixed === null || /not attested by two agreeing/.test(mixedErr), mixedErr || String(mixed));
console.log(`RESULT r61 ${all ? "PASS" : "FAIL"}`); process.exitCode = all ? 0 : 1;
