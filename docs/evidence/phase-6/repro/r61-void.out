// R61 offline proof (head): the void-bond rules on the shipped code.
import { generateKeyPairSync } from "node:crypto";
import { obligationsModeA } from "../../clear/core";
import { balanceSettlement, bondVoidAt } from "../../clear/features";
import { readFileSync } from "node:fs";
import { spawnSync } from "node:child_process";
import path from "node:path";
import { signApprovalMap, verifyApprovalMap, earliestAgreedBond, earliestAgreedDefaults, validateWitnessSet } from "../../witness";
import { verifyRecord, signRecord } from "../../manifest/schema";
import { registry } from "../../clear/registry";
import { endpointKey } from "../../settle/bounded";
let all = true; const line = (id: string, ok: boolean, d: string) => { console.log(`${ok ? "PASS" : "FAIL"} ${id} ${d}`); all &&= ok; };
const C = 1_000_000n;
// Two bonded winners (bond = C, price 300000 + balance 200000 owed) and one loser.
const result: any = { conservation: { payout_zats: "600000" }, allocations: [
  { leaf_index: 0, fill: 1, payment_zats: "300000", refund_zats: "900000", balance_due_zats: "200000" },
  { leaf_index: 1, fill: 1, payment_zats: "300000", refund_zats: "900000", balance_due_zats: "200000" },
  { leaf_index: 2, fill: 0, payment_zats: "0", refund_zats: String(C), balance_due_zats: "0" } ] };
const normal = Object.fromEntries(obligationsModeA(result, { defaults: [], balance_refunds: [] }));
const voided = Object.fromEntries(obligationsModeA(result, { defaults: [], balance_refunds: [], bond_void: true }));
line("r61-normal", normal.seller === "600000" && normal["leaf:0"] === "900000", JSON.stringify(normal));
line("r61-void-refunds-all", voided["leaf:0"] === "1000000" && voided["leaf:1"] === "1000000" && voided["leaf:2"] === "1000000" && voided.seller === undefined, JSON.stringify(voided));
let threw = ""; try { obligationsModeA(result, { defaults: [0], bond_void: true }); } catch (e) { threw = (e as Error).message; }
line("r61-void-no-defaults", /void bond has no defaults/.test(threw), threw);
// bondVoidAt: release = genesis + (R-1)*period.
const m: any = { drand: { genesis: 1000, period: 3, R: 11 }, confirmations: 10, deposit_addresses: ["d0", "d1", "d2"],
  bond: { bond_bps: 1000, balance_window_start_height: 100, balance_window_blocks: 40, balance_addresses: ["b0", "b1", "b2"] } };
line("r61-void-at", bondVoidAt(m, 1029) === true && bondVoidAt(m, 1030) === false, "start header 1029 < release 1030 is void; 1030 is not");
const leaves: any = [0, 1, 2].map(i => ({ leaf_index: i, deposit: { address: `d${i}` } }));
const notes: any = [{ txid: "aa", pool: "ironwood", action_index: 0, address: "b0", value_zats: "200000", height: 110 }];
const s0 = balanceSettlement(m, result, leaves, notes, 200), s1 = balanceSettlement(m, result, leaves, notes, 200, true);
line("r61-balance-normal", s0.sources.length === 1 && s0.refunds.length === 0, `sources ${s0.sources.length} refunds ${s0.refunds.length}`);
line("r61-balance-void", s1.sources.length === 0 && s1.refunds.length === 1 && s1.refunds[0].amount_zats === "200000" && s1.refunds[0].leaf_index === 0, JSON.stringify(s1.refunds));
// Maps: the field joins the signed bytes only when true; a tampered flag fails verification.
const keyPair = () => { const k = generateKeyPairSync("ed25519"); return { priv: Buffer.from(k.privateKey.export({ type: "pkcs8", format: "der" })).subarray(16).toString("hex"), pub: Buffer.from(k.publicKey.export({ type: "spki", format: "der" })).subarray(12).toString("hex") }; };
const [ka, kb] = [keyPair(), keyPair()], keys = [ka.pub, kb.pub];
const body: any = { auction_id: "x", batch: 1, txid: "t1", outputs: [], defaults: [], balance_refunds: [] };
const plainA = signApprovalMap(body, ka.priv), voidA = signApprovalMap({ ...body, bond_void: true }, ka.priv), voidB = signApprovalMap({ ...body, bond_void: true }, kb.priv);
line("r61-map-backcompat", verifyApprovalMap(plainA, keys) && !("bond_void" in plainA), "a map without the field verifies and carries no field");
line("r61-map-tamper", verifyApprovalMap(voidA, keys) && !verifyApprovalMap({ ...voidA, bond_void: false } as any, keys) && !verifyApprovalMap({ ...plainA, bond_void: true } as any, keys), "flipping bond_void either way breaks the signature");
const agreed = earliestAgreedBond([voidA, voidB], keys, ["t1"]); let mixed: any = "not computed";
line("r61-agreed-pair", agreed?.bond_void === true && JSON.stringify(agreed?.defaults) === "[]" && earliestAgreedDefaults([voidA, voidB], keys, ["t1"])?.length === 0, JSON.stringify(agreed));
let mixedErr = ""; try { mixed = earliestAgreedBond([plainA, voidB], keys, ["t1"]); } catch (e) { mixedErr = (e as Error).message; }
line("r61-disagree", mixed === null || /not attested by two agreeing/.test(mixedErr), mixedErr || String(mixed));
// R63: a pre-R61 map from committed evidence keeps its exact signed bytes under the new code.
const old = JSON.parse(readFileSync("docs/evidence/phase-5/markets/launch-a18/launch-cold/auction.json", "utf8"));
const oldKeys = validateWitnessSet(verifyRecord<any>(old.witness_set, old.signer), old.auction_id).keys;
line("r63-map-pre-r61-bytes", old.settlement.approval_maps.every((mp: any) => verifyApprovalMap(mp, oldKeys) && mp.bond_void === undefined && mp.bond_start === undefined), "both committed launch-a18 maps verify unchanged");
// R63: two maps that saw different start headers never agree (no pair, so no attested void).
const hdr = (time: number) => ({ height: 100, hash: "ab".repeat(32), time });
const hA = signApprovalMap({ ...body, bond_void: true, bond_start: hdr(1029) }, ka.priv), hB = signApprovalMap({ ...body, bond_void: true, bond_start: hdr(1031) }, kb.priv);
let hErr = ""; try { earliestAgreedBond([hA, hB], keys, ["t1"]); } catch (e) { hErr = (e as Error).message; }
const hB2 = signApprovalMap({ ...body, bond_void: true, bond_start: hdr(1029) }, kb.priv);
line("r63-header-agreement", /not attested by two agreeing/.test(hErr) && earliestAgreedBond([hA, hB2], keys, ["t1"])?.bond_start?.time === 1029, `different headers refused (${hErr.slice(0, 60)}…); identical headers agree`);
line("r63-header-tamper", !verifyApprovalMap({ ...hA, bond_start: hdr(1031) } as any, keys), "editing a signed start header breaks the signature");
// R63: a bond on a non-mode-A manifest is refused by the registry client wrapper (launch / otc / rfq / buyback).
// R64 (Reviewer R P2-6 on R63): DRIVE the launch client on a real (committed) launch manifest, re-signed with a
// throwaway key — unbonded it is accepted; with a valid-shaped bond it is refused, by the registry wrapper and by
// clientLaunch itself.
const lm = JSON.parse(Buffer.from(old.manifest.bytes, "base64").toString("utf8"));
const { privateKey } = generateKeyPairSync("ed25519"), pem = privateKey.export({ type: "pkcs8", format: "pem" }).toString();
const signedFor = (v: any) => { const pk = signRecord(v, pem); return { pk, signer: (pk as any).signer ?? verifyRecordSigner(pk) }; };
function verifyRecordSigner(pk: any): string { return pk.signer; }
const plain = signRecord(lm, pem) as any, bonded = signRecord({ ...lm, B_max_zats: "2000000", bond: { bond_bps: 1000, balance_window_blocks: 40, balance_window_start_height: 5000000, balance_addresses: lm.deposit_addresses.map(() => (spawnSync(path.resolve("settle/target/release/benzo-pczt"), ["address", path.resolve(".benzo/bidder"), "--network", "test"], { encoding: "utf8" }).stdout.trim().split("\n").at(-1))) } }, pem) as any;
const call = (k: string, pk: any) => { try { (registry as any)[k].client(pk, pk.signer); return "accepted"; } catch (e) { return (e as Error).message; } };
const { clientLaunch } = await import("../../clear/launch");
const direct = (() => { try { clientLaunch(bonded, bonded.signer); return "accepted"; } catch (e) { return (e as Error).message; } })();
line("r64-bonded-launch-refused", call("launch", plain) === "accepted" && /mode A\) feature only/.test(call("launch", bonded)) && /mode A\) feature only/.test(direct),
  `unbonded: ${call("launch", plain)}; bonded via registry: ${call("launch", bonded).slice(0, 70)}; via clientLaunch: ${direct.slice(0, 70)}`);
// R65: one endpoint written two ways is one endpoint.
const same = ["testnet.zec.rocks:443", "Testnet.Zec.Rocks.:443", "testnet.zec.rocks", "https://testnet.zec.rocks:443"].map(endpointKey);
line("r65-endpoint-key", new Set(same).size === 1 && endpointKey("zaino.testnet.unsafe.zec.rocks:443") !== same[0], `${same[0]} for all four spellings; a different host differs`);
console.log(`RESULT r61-r65 ${all ? "PASS" : "FAIL"}`); process.exitCode = all ? 0 : 1;
