--- tmp/r48/proof.ts (not committed as a script: AGENTS.md 8-test ceiling; source kept here for reproduction) ---
import { readFileSync, rmSync } from "node:fs";
import path from "node:path";
import { run, syncRetry } from "../../settle/io";
import { chainTip } from "../../cli/host-chain";
const B = path.resolve("tmp/r48/bin"), HS = path.resolve("tmp/r48/hoststate");
const calls = (f: string) => { try { return readFileSync(f, "utf8").split("\n").filter(Boolean).length; } catch { return 0; } };
let all = true; const line = (ok: boolean, d: string) => { console.log(`${ok ? "PASS" : "FAIL"} ${d}`); all &&= ok; };
let t = Date.now();
try { run(path.join(B, "grpcurl"), ["-d", "{}", "testnet.zec.rocks:443", "x/GetLatestBlock"]); line(false, "grpcurl returned"); }
catch (e) { line(/stalled lightwalletd stream/.test(String(e)), `settle/io run grpcurl bounded in ${Date.now() - t} ms: ${(e as Error).message}`); }
t = Date.now(); rmSync(path.join(B, "calls"), { force: true });
try { syncRetry(() => run(path.join(B, "zcash-devtool"), ["wallet", "-w", "x", "sync", "-s", "testnet.zec.rocks:443"])); line(false, "sync returned"); }
catch (e) { const n = calls(path.join(B, "calls")); line(/stalled lightwalletd stream/.test(String(e)) && n === 4, `settle/io syncRetry: ${n} bounded attempts, refused after ${Date.now() - t} ms: ${(e as Error).message}`); }
t = Date.now(); rmSync(path.join(HS, "bin", "calls"), { force: true });
try { chainTip(HS); line(false, "host chainTip returned"); }
catch (e) { const n = calls(path.join(HS, "bin", "calls")); line(/stalled lightwalletd stream/.test(String(e)) && n === 4, `cli/host-chain chainTip (signer host): ${n} bounded attempts, refused after ${Date.now() - t} ms: ${(e as Error).message}`); }
t = Date.now();
try { run("/bin/sleep", ["3"]); line(Date.now() - t >= 3000, `non-lightwalletd call unbounded (${Date.now() - t} ms)`); } catch (e) { line(false, (e as Error).message); }
console.log(`RESULT r49-stall ${all ? "PASS" : "FAIL"}`); process.exitCode = all ? 0 : 1;
