#!/bin/bash
# clean-run [--offline] CMD...: run CMD as user "stranger" in a private mount namespace where every
# OrbStack host mount is covered by an empty tmpfs; --offline also gives it a network namespace with
# no interfaces but loopback. Environment is reset to HOME + PATH only.
set -e
NET=""
if [ "$1" = "--offline" ]; then NET="--net"; shift; fi
exec unshare --mount $NET --propagation private bash -c '
  for m in /mnt/mac /Applications /Library /Users /Volumes /private /mnt/machines; do
    mountpoint -q "$m" && mount -t tmpfs -o size=1m,mode=000 none "$m"
  done
  [ -n "'"$NET"'" ] && ip link set lo up 2>/dev/null || true
  cd /home/stranger
  exec setpriv --reuid=stranger --regid=stranger --init-groups env -i HOME=/home/stranger \
    PATH=/home/stranger/node/bin:/home/stranger/go/bin:/home/stranger/gopath/bin:/usr/local/bin:/usr/bin:/bin \
    LANG=C.UTF-8 bash -c "$0" 
' "$*"
