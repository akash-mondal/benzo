# Re-pointed (R35.3a, run 33): the red run is the bench batch-plan stage (tools/repro/batching-equal.ts
# folds into `npm run bench` and is deleted at gate RG):
#   git apply this patch, then
#   npx esbuild tools/bench.ts --bundle --packages=external --platform=node --format=esm --outfile=tmp/bench.mut.mjs
#   node tmp/bench.mut.mjs --stage batch-plan tmp/bench-100 100
#   expect ERROR batching-equal-cap13 (and cap28). Green/red record: mutations/B31-a.out (original) and
#   mutations/B31-a-rerun-r33.out (the folded run at cb4bcab).
diff --git a/settle/batching.ts b/settle/batching.ts
index ba0127a..25e29ac 100644
--- a/settle/batching.ts
+++ b/settle/batching.ts
@@ -16,8 +16,8 @@ export function planBatches(obligations: PlanRow[], cap: number): PlannedBatch[]
   requireThat(new Set(parties).size === parties.length, "unique settlement parties");
   // SQLite `ORDER BY party` is BINARY collation: memcmp over the stored UTF-8 bytes. Buffer.compare
   // over the UTF-8 encoding is that order exactly (JS string `<` is UTF-16 code-unit order and
-  // disagrees for non-BMP rows; localeCompare disagrees even for plain ASCII).
-  const sorted = [...obligations].sort((a, b) => Buffer.compare(Buffer.from(a.party, "utf8"), Buffer.from(b.party, "utf8")));
+  // disagrees for non-BMP rows; localeCompare disagrees even for plain ASCII). B31-a: localeCompare.
+  const sorted = [...obligations].sort((a, b) => a.party.localeCompare(b.party));
   const batches: PlannedBatch[] = [];
   for (let i = 0; i < sorted.length; i += cap)
     batches.push({ id: batches.length + 1, parties: sorted.slice(i, i + cap).map(o => o.party) });
